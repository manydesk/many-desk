{
  "name": "many-desk",
  "productName": "ManyDesk",
  "version": "0.12.0",
  "description": "Decentralized peer-to-peer remote desktop for macOS and Windows (WebRTC, connect by ID over public Nostr relays)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build:helper": "bash scripts/build-helper.sh",
    "build:helper:win": "bash scripts/build-helper-win.sh",
    "start": "npm run build:helper && electron .",
    "start:win": "npm run build:helper:win && electron .",
    "dist": "npm run build:helper && electron-builder --mac",
    "dist:win": "npm run build:helper:win && electron-builder --win",
    "dist:tauri:win": "bash scripts/build-tauri-win.sh",
    "dist:all": "npm run build:helper && npm run build:helper:win && electron-builder --mac --win"
  },
  "build": {
    "appId": "az.manydesk.app",
    "productName": "ManyDesk",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "ManyDesk shares your screen with the user you accept.",
        "NSMicrophoneUsageDescription": "ManyDesk uses the microphone for voice chat in a session."
      },
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/bin",
          "to": "bin"
        }
      ]
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/bin-win",
          "to": "bin"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ru_RU",
        "tr_TR"
      ]
    },
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7"
  }
}
